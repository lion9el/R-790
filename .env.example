# Copier ce fichier en ".env" et remplacer les valeurs avant de lancer en production.
# ".env" ne doit JAMAIS être commité (voir .gitignore).

# Clé secrète utilisée pour signer les jetons JWT (backend/auth.py).
# OBLIGATOIRE en production : sans elle, le serveur génère un secret
# temporaire à chaque démarrage (voir l'avertissement affiché au lancement)
# et invalide toutes les sessions à chaque redémarrage.
# Génère une vraie valeur aléatoire avec : python3 -c "import secrets; print(secrets.token_hex(32))"
# puis colle le résultat ci-dessous — NE LAISSE PAS "change-moi", ce n'est
# qu'un exemple, pas une vraie valeur.
SOCIALNET_SECRET=change-moi-avant-la-production

# === Agent IA (routes /api/agent/*, backend/services/agent.py) ===
# Optionnel : le backend démarre normalement sans ces variables, mais les
# routes /api/agent/* répondront 503 tant que GROQ_API_KEY n'est pas défini.

# Comptes autorisés à utiliser l'agent (accès admin), séparés par des virgules.
# Ex: ADMIN_USERNAMES=alice,bob
ADMIN_USERNAMES=

# Même clé que bots/.env.example (GROQ_API_KEY) : un seul provider LLM pour
# tout le projet (bots ET agent d'administration).
# → https://console.groq.com  → Create API Key
# Laisser commenté tant que non configuré : /api/agent/* répond alors un 503
# clair ("GROQ_API_KEY manquant"), plutôt qu'une erreur d'auth Groq confuse
# si tu décommentes sans remplacer la valeur d'exemple.
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=llama-3.3-70b-versatile

# Optionnel : trace chaque décision/outil de l'agent sur LangSmith (audit).
# → https://smith.langchain.com  → Settings → API Keys
# LANGCHAIN_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGCHAIN_PROJECT=socialnet-agent

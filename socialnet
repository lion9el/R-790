#!/usr/bin/env bash
# =============================================================================
# SocialNet — point d'entrée UNIQUE
# =============================================================================
#   ./socialnet          → lance TOUT (Docker si dispo, sinon local)
#   ./socialnet up       → idem
#   ./socialnet api      → API seule locale (--reload)
#   ./socialnet docker   → force Docker
#   ./socialnet local    → force mode local (venv)
#   ./socialnet stop     → arrête
#   ./socialnet status   → santé
#   ./socialnet logs     → logs
# =============================================================================
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-9000}"
URL="http://${HOST}:${PORT}"
PID_DIR="${ROOT}/.run"
VENV_DIR="${ROOT}/.venv"
API_LOG="${ROOT}/.run-api.log"
BOTS_LOG="${ROOT}/.run-bots.log"
API_PID_FILE="${PID_DIR}/api.pid"
BOTS_PID_FILE="${PID_DIR}/bots.pid"
MODE_FILE="${PID_DIR}/mode"

PYTHON="python3"
PIP="pip"

mkdir -p "$PID_DIR"

# Charger .env racine si présent
if [[ -f "$ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT/.env"
  set +a
fi

cmd="${1:-up}"

_die() { echo "✗ $*" >&2; exit 1; }

_has_docker() {
  command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1
}

_compose() {
  if docker compose version >/dev/null 2>&1; then
    docker compose "$@"
  elif command -v docker-compose >/dev/null 2>&1; then
    docker-compose "$@"
  else
    return 1
  fi
}

_cleanup_children() {
  local pid
  for f in "$BOTS_PID_FILE" "$API_PID_FILE"; do
    if [[ -f "$f" ]]; then
      pid="$(cat "$f" 2>/dev/null || true)"
      if [[ -n "${pid}" ]] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
      fi
      rm -f "$f"
    fi
  done
}

_ensure_env() {
  if [[ ! -f "$ROOT/.env" && -f "$ROOT/.env.example" ]]; then
    echo "→ Création de .env depuis .env.example"
    cp "$ROOT/.env.example" "$ROOT/.env"
    echo "  (Édite .env et définis SOCIALNET_SECRET avant la prod)"
  fi
  if [[ ! -f "$ROOT/bots/.env" && -f "$ROOT/bots/.env.example" ]]; then
    cp "$ROOT/bots/.env.example" "$ROOT/bots/.env"
  fi
}

# ─── Mode Docker (recommandé : zéro friction) ───────────────────────────────

_import_local_db_to_docker() {
  # Copie backend/socialnet.db (+ uploads) vers le volume Docker si présent
  local local_db="$ROOT/backend/socialnet.db"
  if [[ ! -f "$local_db" ]]; then
    echo "→ Pas de base locale (backend/socialnet.db) — volume Docker inchangé"
    return 0
  fi
  echo "→ Import de la base locale vers Docker…"
  # Nom de volume compose : <project>_socialnet-data
  local vol
  vol="$(_compose config --volumes 2>/dev/null | head -1 || echo "socialnet_socialnet-data")"
  # Fallback noms courants
  for cand in "socialnet_socialnet-data" "r-790_socialnet-data" "${vol}"; do
    if docker volume inspect "$cand" >/dev/null 2>&1; then
      vol="$cand"
      break
    fi
  done
  docker run --rm \
    -v "${vol}:/dest" \
    -v "$ROOT/backend:/src:ro" \
    alpine:3.20 sh -c '
      set -e
      if [ -f /src/socialnet.db ]; then
        cp -a /src/socialnet.db /dest/socialnet.db
        echo "  socialnet.db importé"
      fi
      if [ -d /src/uploads ]; then
        mkdir -p /dest/uploads
        cp -a /src/uploads/. /dest/uploads/ 2>/dev/null || true
        echo "  uploads importés"
      fi
      ls -la /dest/socialnet.db 2>/dev/null || true
    ' || echo "  (import partiel — volume peut-être encore vide, relance après le 1er up)"
}

cmd_docker() {
  _ensure_env
  if ! _has_docker; then
    _die "Docker non disponible. Installe Docker Desktop (ou docker.io) puis relance."
  fi
  if ! _compose version >/dev/null 2>&1; then
    _die "docker compose introuvable."
  fi
  echo "→ Mode Docker"
  echo "docker" >"$MODE_FILE"
  echo "→ Build + démarrage…"
  _compose up --build -d
  # Après création du volume, importer l'ancienne base si elle existe
  _import_local_db_to_docker
  # Redémarrer le conteneur pour qu'il lise la DB importée
  _compose restart socialnet 2>/dev/null || true
  echo -n "→ Attente API"
  local i
  for i in $(seq 1 60); do
    if curl -sf "$URL/" >/dev/null 2>&1; then
      echo " OK"
      # Bots sur l'hôte (l'image Docker ne les embarque pas)
      _ensure_venv 2>/dev/null || true
      if [[ -x "${VENV_DIR}/bin/python" ]]; then
        PYTHON="${VENV_DIR}/bin/python"
        PIP="${VENV_DIR}/bin/pip"
        "$PIP" install -q -r "$ROOT/bots/requirements-bots.txt" 2>/dev/null || true
      fi
      _start_bots
      echo ""
      echo "╔══════════════════════════════════════════╗"
      echo "║  SocialNet prêt (Docker)                 ║"
      echo "║  Terminal  : $URL"
      echo "║  Ops       : $URL/ops"
      echo "║  Arrêt     : ./socialnet stop            ║"
      echo "║  Logs      : ./socialnet logs            ║"
      echo "╚══════════════════════════════════════════╝"
      echo ""
      return 0
    fi
    echo -n "."
    sleep 1
  done
  echo ""
  _compose logs --tail 40
  _die "API non joignable — voir les logs ci-dessus"
}

# ─── Mode local (venv) ──────────────────────────────────────────────────────

_ensure_venv() {
  if [[ -d "$VENV_DIR" && -x "$VENV_DIR/bin/python" ]]; then
    PYTHON="$VENV_DIR/bin/python"
    PIP="$VENV_DIR/bin/pip"
    return 0
  fi

  echo "→ Création du virtualenv (.venv)…"
  rm -rf "$VENV_DIR" 2>/dev/null || true

  local ok=0
  if python3 -m venv "$VENV_DIR" 2>/dev/null; then
    ok=1
  elif python3 -m venv --copies "$VENV_DIR" 2>/dev/null; then
    ok=1
  elif python3 -m venv --without-pip "$VENV_DIR" 2>/dev/null; then
    ok=1
  elif python3 -m virtualenv "$VENV_DIR" 2>/dev/null; then
    ok=1
  fi

  if [[ "$ok" -ne 1 || ! -x "$VENV_DIR/bin/python" ]]; then
    echo ""
    echo "✗ Impossible de créer un virtualenv."
    echo ""
    echo "  Solutions (une seule suffit) :"
    echo "  1. Docker (recommandé) :  ./socialnet docker"
    echo "  2. sudo apt install python3-venv python3-full"
    echo "  3. python3 -m pip install --user virtualenv && python3 -m virtualenv .venv"
    echo ""
    exit 1
  fi

  PYTHON="$VENV_DIR/bin/python"
  PIP="$VENV_DIR/bin/pip"
  if [[ ! -x "$PIP" ]]; then
    echo "  (bootstrap pip…)"
    curl -sS https://bootstrap.pypa.io/get-pip.py | "$PYTHON" -q
    PIP="$VENV_DIR/bin/pip"
  fi
  "$PIP" install -q --upgrade pip setuptools wheel >/dev/null 2>&1 || true
}

_build_c() {
  echo "→ Extension C…"
  (cd "$ROOT/c_ext" && "$PYTHON" setup.py build_ext --inplace) >>"$API_LOG" 2>&1 \
    || _die "Échec compilation C — voir $API_LOG (installe build-essential + python3-dev)"
}

_install_deps() {
  echo "→ Dépendances Python…"
  "$PIP" install -q -r "$ROOT/requirements.txt" \
    || _die "Échec installation des dépendances"
  # Postgres optionnel (SQLite par défaut — ne bloque pas le démarrage)
  "$PIP" install -q "psycopg[binary]>=3.2.10" 2>/dev/null || true
  if [[ -f "$ROOT/bots/requirements-bots.txt" ]]; then
    "$PIP" install -q -r "$ROOT/bots/requirements-bots.txt" 2>/dev/null || true
  fi
}

_wait_api() {
  echo -n "→ Attente API"
  local i
  for i in $(seq 1 50); do
    if curl -sf "$URL/" >/dev/null 2>&1; then
      echo " OK"
      return 0
    fi
    echo -n "."
    sleep 0.3
  done
  echo ""
  tail -40 "$API_LOG" || true
  _die "API non joignable — logs : $API_LOG"
}

_start_api() {
  echo "→ API sur $URL"
  (
    cd "$ROOT/backend"
    export PYTHONPATH="${ROOT}/backend:${ROOT}/c_ext${PYTHONPATH:+:$PYTHONPATH}"
    exec "$PYTHON" -m uvicorn app:app --host "$HOST" --port "$PORT"
  ) >>"$API_LOG" 2>&1 &
  echo $! >"$API_PID_FILE"
}

_has_real_groq_key() {
  [[ -f "$ROOT/bots/.env" ]] || return 1
  local key
  key="$(grep -E '^GROQ_API_KEY=' "$ROOT/bots/.env" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '[:space:]"'"'")"
  # Rejeter vide, placeholders, et clés trop courtes
  [[ -n "$key" ]] || return 1
  [[ "$key" != *xxxx* ]] || return 1
  [[ "$key" != *xxxxxxxx* ]] || return 1
  [[ ${#key} -ge 20 ]] || return 1
  return 0
}

_start_bots() {
  if ! _has_real_groq_key; then
    echo "→ Bots ignorés (pas de vraie GROQ_API_KEY dans bots/.env)"
    echo "  → https://console.groq.com → Create API Key → bots/.env"
    return 0
  fi
  # S'assurer d'un Python avec les deps bots
  if [[ ! -x "${PYTHON:-}" ]] || [[ "$PYTHON" == "python3" ]]; then
    if [[ -x "$VENV_DIR/bin/python" ]]; then
      PYTHON="$VENV_DIR/bin/python"
    fi
  fi
  echo "→ Bots (nova / echo / orbit)…"
  (
    cd "$ROOT"
    set -a
    # shellcheck disable=SC1091
    source "$ROOT/bots/.env"
    set +a
    export SOCIALNET_URL="${SOCIALNET_URL:-$URL}"
    exec "$PYTHON" bots/runtime.py
  ) >>"$BOTS_LOG" 2>&1 &
  echo $! >"$BOTS_PID_FILE"
  echo "  logs : $BOTS_LOG  |  API : ${SOCIALNET_URL:-$URL}"
}

_chronicle_once() {
  if [[ -f "$ROOT/bots/chronicle.py" ]]; then
    echo "→ Chronique initiale…"
    SOCIALNET_URL="$URL" "$PYTHON" "$ROOT/bots/chronicle.py" >>"$API_LOG" 2>&1 \
      || echo "  (chronique reportée — normal au tout premier démarrage)"
  fi
}

cmd_local() {
  trap '_cleanup_children; echo; echo "Arrêté."; exit 0' INT TERM
  : >"$API_LOG"
  : >"$BOTS_LOG"
  echo "local" >"$MODE_FILE"
  _ensure_env
  _ensure_venv
  _build_c
  _install_deps
  _start_api
  _wait_api
  _chronicle_once
  _start_bots

  echo ""
  echo "╔══════════════════════════════════════════╗"
  echo "║  SocialNet prêt (local)                  ║"
  echo "║  Terminal  : $URL"
  echo "║  Ops       : $URL/ops"
  echo "║  Logs API  : $API_LOG"
  echo "║  Logs bots : $BOTS_LOG"
  echo "║  Ctrl+C    : tout arrêter                ║"
  echo "╚══════════════════════════════════════════╝"
  echo ""

  local api_pid
  api_pid="$(cat "$API_PID_FILE")"
  while kill -0 "$api_pid" 2>/dev/null; do
    sleep 2
  done
  echo "API terminée."
  _cleanup_children
}

# ─── up = auto (Docker si possible, sinon local) ────────────────────────────

cmd_up() {
  if _has_docker && _compose version >/dev/null 2>&1; then
    cmd_docker
  else
    echo "→ Docker indisponible — mode local"
    cmd_local
  fi
}

cmd_api() {
  _ensure_env
  _ensure_venv
  _build_c
  _install_deps
  echo "→ API seule (reload) $URL"
  echo "local" >"$MODE_FILE"
  cd "$ROOT/backend"
  export PYTHONPATH="${ROOT}/backend:${ROOT}/c_ext${PYTHONPATH:+:$PYTHONPATH}"
  exec "$PYTHON" -m uvicorn app:app --host "$HOST" --port "$PORT" --reload
}

cmd_stop() {
  echo "→ Arrêt…"
  local mode
  mode="$(cat "$MODE_FILE" 2>/dev/null || echo "")"
  if [[ "$mode" == "docker" ]] || _has_docker; then
    _compose down 2>/dev/null || true
  fi
  _cleanup_children
  if command -v fuser >/dev/null 2>&1; then
    fuser -k "${PORT}/tcp" 2>/dev/null || true
  fi
  rm -f "$MODE_FILE"
  echo "OK"
}

cmd_status() {
  echo "SocialNet status"
  if curl -sf "$URL/api/ops/status" 2>/dev/null | python3 -m json.tool 2>/dev/null; then
    :
  elif curl -sf "$URL/" >/dev/null 2>&1; then
    echo "API répond sur $URL"
  else
    echo "API down ($URL)"
  fi
  [[ -f "$MODE_FILE" ]] && echo "Mode    : $(cat "$MODE_FILE")"
  [[ -f "$API_PID_FILE" ]] && echo "API pid : $(cat "$API_PID_FILE")"
  [[ -f "$BOTS_PID_FILE" ]] && echo "Bots pid: $(cat "$BOTS_PID_FILE")"
  if _has_docker; then
    _compose ps 2>/dev/null || true
  fi
}

cmd_logs() {
  local mode
  mode="$(cat "$MODE_FILE" 2>/dev/null || echo "")"
  if [[ "$mode" == "docker" ]]; then
    _compose logs --tail 50
  else
    echo "=== API (fin) ==="
    tail -n 40 "$API_LOG" 2>/dev/null || echo "(pas de log)"
    echo "=== BOTS (fin) ==="
    tail -n 40 "$BOTS_LOG" 2>/dev/null || echo "(pas de log)"
  fi
}

case "$cmd" in
  up|start|all) cmd_up ;;
  docker)       cmd_docker ;;
  local)        cmd_local ;;
  api|dev)      cmd_api ;;
  stop)         cmd_stop ;;
  status)       cmd_status ;;
  logs)         cmd_logs ;;
  help|-h|--help)
    echo "Usage: ./socialnet [up|docker|local|api|stop|status|logs]"
    echo ""
    echo "  up (défaut)  Docker si dispo, sinon local — UNE commande"
    echo "  docker       Force Docker (recommandé, zéro friction)"
    echo "  local        Force mode local (venv)"
    echo "  api          API seule avec --reload (dev)"
    echo "  stop         Arrête tout"
    echo "  status       Santé"
    echo "  logs         Derniers logs"
    ;;
  *)
    _die "Commande inconnue: $cmd (essaie ./socialnet help)"
    ;;
esac

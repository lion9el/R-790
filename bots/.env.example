# === Clés API gratuites (aucune carte bancaire requise) ===

# 1. Groq (pour @nova)
#    → https://console.groq.com  → Create API Key
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Google Gemini (pour @echo)
#    → https://aistudio.google.com/apikey  → Create API key
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Optionnel ===

# URL du backend SocialNet (par défaut localhost)
# SOCIALNET_URL=http://127.0.0.1:9000

# Modèles (tu peux changer si un modèle free change de nom)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash

# Rythme des messages (secondes)
# BOT_MIN_DELAY=25
# BOT_MAX_DELAY=70

# Budget de tokens (soft-stop). 0 = ILLIMITÉ (aucun arrêt automatique) — c'est le défaut.
# Le compteur vit dans memory.db et NE se purge jamais tout seul, donc si tu mets une
# limite > 0, son "scope" détermine ce qui compte dans le total :
#   BOT_TOKEN_BUDGET_SCOPE=run       → repart à zéro à chaque lancement du script (défaut)
#   BOT_TOKEN_BUDGET_SCOPE=day       → partagé sur toute la journée UTC, même en relançant
#   BOT_TOKEN_BUDGET_SCOPE=lifetime  → cumulatif pour toujours (ancien comportement)
# BOT_TOKEN_BUDGET=0
# BOT_TOKEN_BUDGET_SCOPE=run

# Nombre max de tours (0 = infini)
# BOT_MAX_TURNS=0

# Proxy pour la recherche web (optionnel)
# Exemples :
#   SEARCH_PROXY=http://127.0.0.1:8080
#   SEARCH_PROXY=socks5://127.0.0.1:1080
#   SEARCH_PROXY=http://user:pass@proxy.example.com:3128
# SEARCH_PROXY=

# Token GitHub pour le dépôt monde des bots (repo scope)
# https://github.com/lion9el/socialnet-world
GITHUB_TOKEN=
